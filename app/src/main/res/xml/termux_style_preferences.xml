<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:title="@string/termux_appearance_header">

        <SwitchPreferenceCompat
            app:key="background_image_enabled"
            app:summary="@string/termux_background_image_enabled"
            app:title="@string/termux_background_image_enabled_title" />
            
        <SwitchPreferenceCompat
            app:key="monet_background_enabled"
            app:summary="@string/termux_monet_background_enabled"
            app:title="@string/termux_monet_background_enabled_title" />
        
        <SwitchPreferenceCompat
            app:key="extrakeys_blur_enabled"
            app:summary="@string/termux_extrakeys_blur_enabled"
            app:title="@string/termux_extrakeys_blur_enabled_title" />
        
        <SwitchPreferenceCompat
            app:key="sessions_blur_enabled"
            app:summary="@string/termux_sessions_blur_enabled"
            app:title="@string/termux_sessions_blur_enabled_title" />
    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/termux_security_header">

        <SwitchPreferenceCompat
            app:key="biometric_auth_enabled"
            app:summary="@string/termux_biometric_auth_enabled"
            app:title="@string/termux_biometric_auth_enabled_title" />
    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/termux_extension_header">

        <SwitchPreferenceCompat
            app:key="builtin_tapi_enabled"
            app:summary="@string/termux_builtin_tapi_enabled"
            app:title="@string/termux_builtin_tapi_enabled_title" />
    </PreferenceCategory>

</PreferenceScreen>
